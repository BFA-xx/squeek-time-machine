DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/squeek_time_machine
PORT=4300
# Stays on 127.0.0.1 unless the proxy is on another machine
HOST=127.0.0.1
# Long random string. Required for the moderation routes; they stay closed without it.
ADMIN_TOKEN=
# Long random string, the same one the web app has. Lets it pass on the visitor's address for rate limiting.
PROXY_SECRET=
# Comma-separated origins allowed to send cookies and writes, e.g. https://time.example.com
WEB_ORIGINS=http://localhost:3300
# Domain shown in wallet sign-in messages, with no scheme
WALLET_DOMAIN=localhost:3300
SQUEEK_API_BASE=https://api.squeekchain.com
# Read-only Sepolia RPCs, tried in order, used to backfill settlements older than the API's recent list
SEPOLIA_RPC_URLS=https://sepolia.gateway.tenderly.co,https://rpc.sepolia.ethpandaops.io,https://ethereum-sepolia-rpc.publicnode.com
INGESTION_ENABLED=true
